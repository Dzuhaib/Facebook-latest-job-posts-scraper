# Get this at https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_replace_me

# Optional overrides (defaults shown)
# FB_WINDOW_MINUTES=10
# FB_MIN_SCORE=4
# FB_MAX_RESULTS_PER_SOURCE=30
# FB_OUTPUT_DIR=./output
# FB_WATCH_INTERVAL_MINUTES=10
# FB_RETENTION_HOURS=0

# Optional notifications for new leads (set any or all)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# NOTIFY_WEBHOOK_URL=

# Local dashboard (npm run ui)
# UI_HOST=127.0.0.1
# UI_PORT=3000
# UI_ALLOW_ANY_HOST=0
